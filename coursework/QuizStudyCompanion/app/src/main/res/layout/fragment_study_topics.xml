<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen heading -->
        <TextView
            android:id="@+id/topicsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fragment_topics_heading"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Python topic -->
        <Button
            android:id="@+id/buttonPythonTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fragment_topic_python"
            android:layout_marginBottom="12dp" />

        <!-- Cybersecurity topic -->
        <Button
            android:id="@+id/buttonCybersecurityTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fragment_topic_cybersecurity"
            android:layout_marginBottom="12dp" />

        <!-- C# topic -->
        <Button
            android:id="@+id/buttonCsharpTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fragment_topic_csharp" />

    </LinearLayout>

</ScrollView>
