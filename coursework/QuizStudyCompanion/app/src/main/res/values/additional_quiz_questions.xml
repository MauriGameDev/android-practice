    <!-- Question 1: Beginner -->
    <string name="cyber_q1">
        What does multi-factor authentication (MFA) add to account security?
    </string>

    <string-array name="cyber_q1_options">
        <item>A longer username</item>
        <item>Another verification factor</item>
        <item>Automatic file encryption</item>
        <item>Unlimited login attempts</item>
    </string-array>

    <!-- Correct Answer: Index 1 -->

    <!-- Question 2: Beginner -->
    <string name="cyber_q2">
        What does availability mean in the CIA Triad?
    </string>

    <string-array name="cyber_q2_options">
        <item>Keeping information secret</item>
        <item>Preventing unauthorized changes</item>
        <item>Making systems accessible when needed</item>
        <item>Requiring passwords for every file</item>
    </string-array>

    <!-- Correct Answer: Index 2 -->

    <!-- Question 3: Intermediate -->
    <string name="cyber_q3">
        You receive an unexpected email asking you to reset your password.
        What is the safest first action?
    </string>

    <string-array name="cyber_q3_options">
        <item>Visit the official website directly to verify the request</item>
        <item>Click the email link immediately</item>
        <item>Reply with your current password</item>
        <item>Forward the email to all coworkers</item>
    </string-array>

    <!-- Correct Answer: Index 0 -->

    <!-- Question 4: Intermediate -->
    <string name="cyber_q4">
        What is the principle of least privilege?
    </string>

    <string-array name="cyber_q4_options">
        <item>Giving every employee administrator access</item>
        <item>Granting only the permissions needed for a task</item>
        <item>Allowing users to share their passwords</item>
        <item>Removing authentication from internal systems</item>
    </string-array>

    <!-- Correct Answer: Index 1 -->

    <!-- Question 5: Advanced -->
    <string name="cyber_q5">
        Which approach is recommended for securely storing user passwords?
    </string>

    <string-array name="cyber_q5_options">
        <item>Store passwords as plain text</item>
        <item>Encrypt passwords with a publicly shared key</item>
        <item>Store uniquely salted hashes using a password-hashing algorithm</item>
        <item>Store passwords directly in application logs</item>
    </string-array>

    <!-- Correct Answer: Index 2 -->


